# ── MomzVeda Environment Variables ──

# Anthropic API (for AI chat)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Price IDs (create these in Stripe Dashboard → Products)
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_your_monthly_price_id_here
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_your_yearly_price_id_here

# App URL
NEXT_PUBLIC_APP_URL=https://momzveda.com
